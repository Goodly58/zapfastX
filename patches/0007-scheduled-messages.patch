+    /// Patched build: queues a scheduled message at once, with its files
+    /// where they are and pasted pictures written out, then copies the files
+    /// off this thread, as a long video takes a while. A message that cannot
+    /// be queued goes back to the composer as it was.
+    fn schedule(
+        &mut self,
+        mut item: crate::scheduled::Scheduled,
+        attachments: Vec<crate::scheduled::Attachment>,
+    ) {
+        let state = self.dirs.state.clone();
+        let queued = crate::scheduled::prepare(&state, item.id, &attachments).and_then(|files| {
+            item.files = files;
+            crate::scheduled::add(&self.archive, &self.dirs.id, item.clone())
+        });
+        if let Err(error) = queued {
+            log::warn!("could not schedule a message: {error}");
+            crate::scheduled::discard(&state, item.id);
+            crate::scheduled::hide(item.id);
+            self.unschedule(item, attachments);
+            return;
+        }
+        let originals = crate::scheduled::originals(&state, item.id, &item.files);
+        if originals.is_empty() {
+            return;
+        }
+        let id = item.id;
+        let commands = self.commands.clone();
+        tokio::task::spawn_blocking(move || {
+            let copies = crate::scheduled::copy_originals(&state, id, &originals);
+            let _ = commands.send(Command::ScheduleKept(id, copies));
+        });
+    }
+
+    /// Patched build: points a scheduled message at the copies of its files.
+    /// Without them it still goes, from the originals.
+    fn scheduled_copies(&mut self, id: u64, copies: Result<Vec<(usize, PathBuf)>, String>) {
+        let state = &self.dirs.state;
+        let used = copies.and_then(|copies| {
+            crate::scheduled::use_copies(&self.archive, &self.dirs.id, id, &copies)
+        });
+        match used {
+            Ok(true) => {}
+            // Cancelled meanwhile, or already sent from the originals.
+            Ok(false) => crate::scheduled::discard_unless_sent(state, id),
+            Err(error) => match crate::scheduled::queued(&self.archive, id) {
+                Ok(true) => {
+                    log::warn!("scheduled message {id} keeps its original files: {error}");
+                    self.emit(Event::Error(format!(
+                        "{error}. The message is still scheduled and will be sent from the original, so leave it where it is until then."
+                    )));
+                }
+                Ok(false) => crate::scheduled::discard_unless_sent(state, id),
+                // A queue that cannot be read may still hold the message, so
+                // its files stay.
+                Err(read) => log::warn!("{error}; {read}"),
+            },
+        }
+    }
+
+    /// Patched build: hands a message that could not be scheduled back to
+    /// its composer, as a refused send is.
+    fn unschedule(
+        &self,
+        item: crate::scheduled::Scheduled,
+        attachments: Vec<crate::scheduled::Attachment>,
+    ) {
+        let mut caption = Some(item.text).filter(|text| !text.is_empty());
+        if attachments.is_empty() {
+            let text = caption.unwrap_or_default();
+            self.refuse(item.chat, None, Unsent::Text(text), Refusal::NotScheduled);
+            return;
+        }
+        let mut returned = false;
+        for attachment in attachments {
+            let unsent = match attachment {
+                crate::scheduled::Attachment::File { path, document } => Unsent::Files {
+                    paths: vec![path],
+                    documents: document,
+                    view_once: false,
+                    caption: caption.take(),
+                },
+                crate::scheduled::Attachment::Picture {
+                    width,
+                    height,
+                    rgba,
+                } => {
+                    // The composer cannot show a picture missing pixels.
+                    if !crate::scheduled::whole_picture(width, height, &rgba) {
+                        continue;
+                    }
+                    Unsent::Image {
+                        width,
+                        height,
+                        rgba,
+                        view_once: false,
+                        caption: caption.take(),
+                    }
+                }
+            };
+            self.refuse(item.chat.clone(), None, unsent, Refusal::NotScheduled);
+            returned = true;
+        }
+        if !returned {
+            self.emit(Event::Error(
+                "Not scheduled: ZapFast could not keep the pictures.".to_owned(),
+            ));
+        }
+    }
+
+    /// Patched build: hands a due scheduled message back to its composer, its
+    /// files as their copies, as a refused send is.
+    fn hand_back_scheduled(&self, item: crate::scheduled::Scheduled) {
+        crate::scheduled::mark_sent(&self.dirs.state, item.id);
+        let mut caption = Some(item.text.clone()).filter(|text| !text.is_empty());
+        if item.files.is_empty() {
+            let text = caption.unwrap_or_default();
+            self.refuse(item.chat, None, Unsent::Text(text), Refusal::ScheduledReadOnly);
+            return;
+        }
+        for (documents, paths) in item.runs() {
+            let unsent = Unsent::Files {
+                paths,
+                documents,
+                view_once: false,
+                caption: caption.take(),
+            };
+            self.refuse(item.chat.clone(), None, unsent, Refusal::ScheduledReadOnly);
+        }
+    }
+
+    /// Patched build: sends a scheduled message as the composer would have,
+    /// through the same command handling, at once, so a blocked chat is
+    /// refused as usual: the text alone, or the files in runs of one kind
+    /// with the text as the first one's caption. Until the account can tell
+    /// whether the chat takes messages, the message waits; a chat that no
+    /// longer does gets it back in its composer.
+    async fn send_scheduled(&mut self, item: crate::scheduled::Scheduled) {
+        let blocked = self.blocklist.contains(&self.canonical_str(&item.chat));
+        if !blocked {
+            if !self.privacy_ready || self.archive.chat(&item.chat).is_err() {
+                let id = item.id;
+                if let Err(error) = crate::scheduled::add(&self.archive, &self.dirs.id, item) {
+                    log::warn!("scheduled message {id} could not wait: {error}");
+                }
+                return;
+            }
+            if !self.destination_writable(&item.chat) {
+                self.hand_back_scheduled(item);
+                return;
+            }
+        }
+        crate::scheduled::mark_sent(&self.dirs.state, item.id);
+        let mut commands = Vec::new();
+        if item.files.is_empty() {
+            commands.push(Command::SendText {
+                chat: item.chat,
+                text: item.text,
+                quoting: None,
+                mentions: item.mentions,
+                preview: None,
+            });
+        } else {
+            let mut caption = Some(item.text.clone()).filter(|text| !text.is_empty());
+            let mut mentions = item.mentions.clone();
+            for (documents, paths) in item.runs() {
+                commands.push(Command::SendFiles {
+                    chat: item.chat.clone(),
+                    paths,
+                    documents,
+                    view_once: false,
+                    caption: caption.take(),
+                    mentions: std::mem::take(&mut mentions),
+                    quoting: None,
+                });
+            }
+        }
+        for command in commands {
+            Box::pin(self.handle_command(command)).await;
+        }
+        crate::scheduled::tidy(&self.archive, &self.dirs.state);
+    }

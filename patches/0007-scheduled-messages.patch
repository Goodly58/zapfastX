+    /// Patched build: keeps ZapFast's own copy of each attachment, so the
+    /// originals can move or go before the message is sent, then queues it.
+    /// The copies are made off this thread, as a long video takes a while.
+    fn schedule(
+        &mut self,
+        item: crate::scheduled::Scheduled,
+        attachments: Vec<crate::scheduled::Attachment>,
+    ) {
+        if attachments.is_empty() {
+            self.queue_scheduled(item, attachments, Ok(Vec::new()));
+            return;
+        }
+        let state = self.dirs.state.clone();
+        let commands = self.commands.clone();
+        tokio::task::spawn_blocking(move || {
+            let kept = crate::scheduled::keep(&state, item.id, &attachments);
+            let _ = commands.send(Command::ScheduleKept(item, attachments, kept));
+        });
+    }
+
+    /// Patched build: queues a scheduled message once its copies are made.
+    /// One that cannot be queued goes back to the composer as it was.
+    fn queue_scheduled(
+        &mut self,
+        mut item: crate::scheduled::Scheduled,
+        attachments: Vec<crate::scheduled::Attachment>,
+        kept: Result<Vec<crate::scheduled::ScheduledFile>, String>,
+    ) {
+        if crate::scheduled::was_cancelled(item.id) {
+            crate::scheduled::discard(&self.dirs.state, item.id);
+            return;
+        }
+        let queued = kept.and_then(|files| {
+            item.files = files;
+            crate::scheduled::add(&self.archive, item.clone())
+        });
+        let Err(error) = queued else {
+            return;
+        };
+        log::warn!("could not schedule a message: {error}");
+        crate::scheduled::discard(&self.dirs.state, item.id);
+        crate::scheduled::hide(item.id);
+        let mut caption = Some(item.text).filter(|text| !text.is_empty());
+        if attachments.is_empty() {
+            let text = caption.unwrap_or_default();
+            self.refuse(item.chat, None, Unsent::Text(text), Refusal::NotScheduled);
+            return;
+        }
+        for attachment in attachments {
+            let unsent = match attachment {
+                crate::scheduled::Attachment::File { path, document } => Unsent::Files {
+                    paths: vec![path],
+                    documents: document,
+                    view_once: false,
+                    caption: caption.take(),
+                },
+                crate::scheduled::Attachment::Picture {
+                    width,
+                    height,
+                    rgba,
+                } => Unsent::Image {
+                    width,
+                    height,
+                    rgba,
+                    view_once: false,
+                    caption: caption.take(),
+                },
+            };
+            self.refuse(item.chat.clone(), None, unsent, Refusal::NotScheduled);
+        }
+    }
+
+    /// Patched build: sends a scheduled message as the composer would have:
+    /// the text alone, or the files in runs of one kind with the text as the
+    /// first one's caption.
+    fn send_scheduled(&mut self, item: crate::scheduled::Scheduled) {
+        if item.files.is_empty() {
+            self.send_text(item.chat, item.text, None, item.mentions, None);
+            return;
+        }
+        let mut caption = Some(item.text.clone()).filter(|text| !text.is_empty());
+        let mut mentions = item.mentions.clone();
+        for (documents, paths) in item.runs() {
+            self.send_files(
+                item.chat.clone(),
+                paths,
+                FileSendOptions {
+                    documents,
+                    view_once: false,
+                },
+                caption.take(),
+                std::mem::take(&mut mentions),
+                None,
+            );
+        }
+        crate::scheduled::mark_sent(&self.dirs.state, item.id);
+        crate::scheduled::tidy(&self.archive, &self.dirs.state);
+    }

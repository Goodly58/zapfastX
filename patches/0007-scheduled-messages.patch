+    #[test]
+    fn only_copies_of_messages_long_gone_are_swept() {
+        let state = tempfile::tempdir().unwrap();
+        for id in [1_u64, 2, 3] {
+            std::fs::create_dir_all(files_dir(state.path(), id)).unwrap();
+        }
+        mark_sent(state.path(), 3);
+        let mut queued = Scheduled::new("swept@s.whatsapp.net".into(), String::new(), Vec::new(), 0);
+        queued.id = 1;
+        let later = SystemTime::now() + KEEP_SENT + Duration::from_secs(60);
+        sweep(state.path(), &[queued.clone()], SystemTime::now());
+        assert!(files_dir(state.path(), 2).exists(), "not a week old yet");
+        sweep(state.path(), &[queued], later);
+        assert!(files_dir(state.path(), 1).exists(), "still queued");

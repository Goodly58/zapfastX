+    #[test]
+    fn due_messages_leave_the_queue_once() {
+        let archive = Archive::in_memory().unwrap();
+        let chat = "due-once@s.whatsapp.net";
+        let mut early = Scheduled::new(chat.into(), "early".into(), Vec::new(), 100);
+        early.id = 1;
+        let mut late = Scheduled::new(chat.into(), "late".into(), Vec::new(), 300);
+        late.id = 2;
+        add(&archive, late).unwrap();
+        add(&archive, early).unwrap();
+        let due = take_due(&archive, 200);
+        assert_eq!(due.iter().map(|item| item.id).collect::<Vec<_>>(), [1]);
+        assert!(take_due(&archive, 200).is_empty());
+        assert_eq!(for_chat(chat).iter().map(|item| item.id).collect::<Vec<_>>(), [2]);
+        cancel(&archive, Path::new("unused"), 2).unwrap();

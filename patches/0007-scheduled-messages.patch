+        assert_eq!(at_on(now, 0, "21:30"), Some(at(today, 21, 30)));
+        assert_eq!(
+            at_on(now, 0, "9:05"),
+            Some(at(today.tomorrow().unwrap(), 9, 5)),
+            "a time already passed today is tomorrow's"
+        );
+        let thursday = jiff::civil::date(2026, 11, 12);
+        assert_eq!(at_on(now, 2, "9:05"), Some(at(thursday, 9, 5)));
+        assert_eq!(at_on(now, 2, "25:00"), None);
+        assert_eq!(day_label(now, 0), "Today");
+        assert_eq!(day_label(now, 1), "Tomorrow");
+        assert_eq!(day_label(now, 2), "Thu 12 Nov");
+    }
+}

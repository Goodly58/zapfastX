+/// Patched build: a Send-later menu opened anew starts on today.
+pub(super) fn reset_schedule_day(ctx: &egui::Context) {
+    ctx.data_mut(|data| data.remove::<i64>(egui::Id::new("schedule-day")));
+}
+
+/// Patched build: the Send button's right-click menu, which sends the
+/// composed text, and any attachments, later instead of now.
+pub(super) fn schedule_menu(app: &mut App, ui: &mut egui::Ui, chat: &str) {
+    let palette = app.palette;
+    let now = crate::util::now();
+    let mut chosen = None;
+    theme::text(ui, "Send later", theme::semibold(12.5), palette.secondary);
+    for (label, at) in crate::scheduled::presets(now) {
+        if widgets::menu_item(ui, &palette, Some(Icon::Clock), &label) {
+            chosen = Some(at);
+        }
+    }
+    let id = egui::Id::new("schedule-at");
+    let mut custom = ui.data(|data| data.get_temp::<String>(id)).unwrap_or_default();
+    // The day the typed time is on, from today up to six days ahead.
+    let day_id = egui::Id::new("schedule-day");
+    let mut day = ui.data(|data| data.get_temp::<i64>(day_id)).unwrap_or(0);
+    ui.horizontal(|ui| {
+        if ui
+            .add_enabled(day > 0, egui::Button::new("‹").small())
+            .on_hover_text("Earlier day")
+            .clicked()
+        {
+            day -= 1;
+        }
+        ui.add_sized(
+            vec2(76.0, 18.0),
+            egui::Label::new(crate::scheduled::day_label(now, day)),
+        );
+        if ui
+            .add_enabled(
+                day < crate::scheduled::LAST_DAY,
+                egui::Button::new("›").small(),
+            )
+            .on_hover_text("Later day")
+            .clicked()
+        {
+            day += 1;
+        }
+    });
+    ui.data_mut(|data| data.insert_temp(day_id, day));
+    let custom_at = crate::scheduled::at_on(now, day, &custom);
+    ui.horizontal(|ui| {
+        let field = ui.add(
+            egui::TextEdit::singleline(&mut custom)
+                .hint_text("21:30")
+                .desired_width(56.0),
+        );
+        // Enter in the field sends at that time, as the button does.
+        if field.lost_focus() && ui.input(|input| input.key_pressed(egui::Key::Enter)) {
+            chosen = custom_at;
+        }
+        let label = match custom_at {
+            Some(at) => format!("Send {}", crate::scheduled::when_label(at)),
+            None => "Send at a time".to_owned(),
+        };
+        if ui
+            .add_enabled(custom_at.is_some(), egui::Button::new(label))
+            .clicked()
+        {
+            chosen = custom_at;
+        }
+    });
+    ui.data_mut(|data| data.insert_temp(id, custom));
+    if let Some(at) = chosen {
+        let text = std::mem::take(&mut app.composer);
+        app.schedule_text(chat.to_owned(), text, at);
+        app.focus_composer = true;
+        ui.close();
+    }
+}

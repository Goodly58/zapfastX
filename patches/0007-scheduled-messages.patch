+//! Patched build: messages written now and sent later.
+//!
+//! Each account's backend keeps its queue in the archive's meta table, so it
+//! survives restarts, and sends what is due on its five-second tick through
+//! the usual text and file paths. Nothing goes out while ZapFast is closed: a
+//! message that came due meanwhile is sent once ZapFast is connected again.
+//! The queue is also kept process-wide, so the composer lists it without
+//! asking the backend.
+//!
+//! A message with attachments keeps ZapFast's own copy of each in the
+//! account's `scheduled` folder, so the originals can move or go before it is
+//! sent. A cancelled message's copies go at once; a sent one's a week after
+//! it went, as a file that could not be sent may still be offered again.
+
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, MutexGuard, OnceLock, PoisonError};
+use std::time::{Duration, SystemTime};
+
+use serde::{Deserialize, Serialize};
+
+use crate::archive::Archive;
+use crate::model::ChatId;
+
+const META_KEY: &str = "fork_scheduled";
+
+/// How long a sent message's copies are kept.
+const KEEP_SENT: Duration = Duration::from_secs(7 * 24 * 60 * 60);
+
+/// The furthest day the composer offers, counted from today.
+pub const LAST_DAY: i64 = 6;
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Scheduled {
+    /// Unique for the life of the queue.
+    pub id: u64,
+    pub chat: ChatId,
+    /// Composer text, its mentions already encoded; the first file's caption
+    /// when there are files.
+    pub text: String,
+    pub mentions: Vec<String>,
+    /// When to send, in Unix seconds.
+    pub at: i64,
+    /// Attachments, in the order they were staged. Queues saved before files
+    /// could be scheduled have none.
+    #[serde(default)]
+    pub files: Vec<ScheduledFile>,
+}
+
+/// One scheduled attachment.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct ScheduledFile {
+    /// ZapFast's own copy once the backend has queued the message; the
+    /// original until then.
+    pub path: PathBuf,
+    /// Sent as a document with its own bytes, as the composer's document
+    /// attachments are.
+    pub document: bool,
+}
+
+/// An attachment as the composer hands it over to be scheduled.
+#[derive(Debug)]
+pub enum Attachment {
+    File { path: PathBuf, document: bool },
+    /// A pasted picture as straight-alpha RGBA, kept as a PNG.
+    Picture {
+        width: u32,
+        height: u32,
+        rgba: Vec<u8>,
+    },
+}
+
+/// The file name a pasted picture is kept and sent under.
+const PICTURE_NAME: &str = "picture.png";
+
+impl Attachment {
+    /// What the composer lists until the backend has made its copy.
+    pub fn listed(&self) -> ScheduledFile {
+        match self {
+            Self::File { path, document } => ScheduledFile {
+                path: path.clone(),
+                document: *document,
+            },
+            Self::Picture { .. } => ScheduledFile {
+                path: PathBuf::from(PICTURE_NAME),
+                document: false,
+            },
+        }
+    }
+}
+
+impl Scheduled {
+    pub fn new(chat: ChatId, text: String, mentions: Vec<String>, at: i64) -> Self {
+        let id = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_or(0, |elapsed| elapsed.as_nanos() as u64);
+        Self {
+            id,
+            chat,
+            text,
+            mentions,
+            at,
+            files: Vec::new(),
+        }
+    }
+
+    /// One line for the composer's list: the files, then the text.
+    pub fn preview(&self) -> String {
+        let text = self.text.lines().next().unwrap_or_default();
+        let Some(first) = self.files.first() else {
+            return text.to_owned();
+        };
+        let name = first
+            .path
+            .file_name()
+            .map(|name| name.to_string_lossy().into_owned())
+            .unwrap_or_default();
+        let files = match self.files.len() {
+            1 => name,
+            count => format!("{name} and {} more", count - 1),
+        };
+        if text.is_empty() {
+            files
+        } else {
+            format!("{files} · {text}")
+        }
+    }
+
+    /// The files in runs of one kind, as the composer sends them: each run
+    /// goes as one send, the caption with the first.
+    pub fn runs(&self) -> Vec<(bool, Vec<PathBuf>)> {
+        let mut runs: Vec<(bool, Vec<PathBuf>)> = Vec::new();
+        for file in &self.files {
+            match runs.last_mut() {
+                Some((document, paths)) if *document == file.document => {
+                    paths.push(file.path.clone());
+                }
+                _ => runs.push((file.document, vec![file.path.clone()])),
+            }
+        }
+        runs
+    }
+}
+
+/// Where a message's copies are kept.
+fn files_dir(state: &Path, id: u64) -> PathBuf {
+    state.join("scheduled").join(id.to_string())
+}
+
+/// Keeps ZapFast's own copy of each attachment, under its own name, as a
+/// document's name is what the other side sees. The attachments stay the
+/// caller's, to go back to the composer if this fails.
+pub fn keep(state: &Path, id: u64, attachments: &[Attachment]) -> Result<Vec<ScheduledFile>, String> {
+    let dir = files_dir(state, id);
+    let mut files = Vec::new();
+    for (index, attachment) in attachments.iter().enumerate() {
+        // A folder each, so two files of one name both keep it.
+        let slot = dir.join(index.to_string());
+        std::fs::create_dir_all(&slot)
+            .map_err(|error| format!("Could not keep the attachments: {error}"))?;
+        match attachment {
+            Attachment::File { path, document } => {
+                // The queue is JSON, so the copy's name must be valid text.
+                let name = path
+                    .file_name()
+                    .map(|name| name.to_string_lossy().into_owned())
+                    .ok_or_else(|| format!("{} is not a file", path.display()))?;
+                let copy = slot.join(&name);
+                std::fs::copy(path, &copy)
+                    .map_err(|error| format!("Could not keep a copy of {name}: {error}"))?;
+                files.push(ScheduledFile {
+                    path: copy,
+                    document: *document,
+                });
+            }
+            Attachment::Picture {
+                width,
+                height,
+                rgba,
+            } => {
+                use image::ImageEncoder;
+                let expected = u64::from(*width) * u64::from(*height) * 4;
+                if rgba.len() as u64 != expected {
+                    return Err("Could not keep the picture: its pixels are incomplete".to_owned());
+                }
+                let copy = slot.join(PICTURE_NAME);
+                let mut bytes = Vec::new();
+                image::codecs::png::PngEncoder::new(&mut bytes)
+                    .write_image(rgba, *width, *height, image::ExtendedColorType::Rgba8)
+                    .map_err(|error| format!("Could not keep the picture: {error}"))?;
+                std::fs::write(&copy, bytes)
+                    .map_err(|error| format!("Could not keep the picture: {error}"))?;
+                files.push(ScheduledFile {
+                    path: copy,
+                    document: false,
+                });
+            }
+        }
+    }
+    Ok(files)
+}
+
+/// Removes a message's copies.
+pub fn discard(state: &Path, id: u64) {
+    let dir = files_dir(state, id);
+    if dir.exists()
+        && let Err(error) = std::fs::remove_dir_all(&dir)
+    {
+        log::warn!("could not remove a scheduled message's files: {error}");
+    }
+}
+
+/// The mark a message's folder gets when it is sent, dated then.
+const SENT_MARK: &str = "sent";
+
+/// Notes that a message's files went out, which starts their week.
+pub fn mark_sent(state: &Path, id: u64) {
+    let dir = files_dir(state, id);
+    if dir.exists()
+        && let Err(error) = std::fs::write(dir.join(SENT_MARK), b"")
+    {
+        log::warn!("could not mark a scheduled message sent: {error}");
+    }
+}
+
+/// Removes the copies of messages no longer queued a week after they went,
+/// or a week after they were made when the mark is missing.
+fn sweep(state: &Path, queue: &[Scheduled], now: SystemTime) {
+    let Ok(entries) = std::fs::read_dir(state.join("scheduled")) else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let queued = entry
+            .file_name()
+            .to_str()
+            .and_then(|name| name.parse::<u64>().ok())
+            .is_some_and(|id| queue.iter().any(|item| item.id == id));
+        if queued {
+            continue;
+        }
+        let dated = std::fs::metadata(entry.path().join(SENT_MARK))
+            .or_else(|_| entry.metadata())
+            .and_then(|meta| meta.modified());
+        let old = dated
+            .ok()
+            .and_then(|modified| now.duration_since(modified).ok())
+            .is_some_and(|age| age > KEEP_SENT);
+        if old {
+            let _ = std::fs::remove_dir_all(entry.path());
+        }
+    }
+}
+
+fn shown() -> MutexGuard<'static, Vec<Scheduled>> {
+    static SHOWN: OnceLock<Mutex<Vec<Scheduled>>> = OnceLock::new();
+    SHOWN
+        .get_or_init(Default::default)
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+}
+
+fn stored(archive: &Archive) -> Vec<Scheduled> {
+    archive
+        .meta(META_KEY)
+        .ok()
+        .flatten()
+        .and_then(|json| serde_json::from_str(&json).ok())
+        .unwrap_or_default()
+}
+
+fn store(archive: &Archive, queue: &[Scheduled]) -> Result<(), String> {
+    let json = serde_json::to_string(queue)
+        .map_err(|error| format!("could not encode the scheduled messages: {error}"))?;
+    archive
+        .set_meta(META_KEY, &json)
+        .map_err(|error| format!("could not save the scheduled messages: {error}"))
+}
+
+/// Messages cancelled before the backend had queued them, while their
+/// attachments were still being copied.
+fn cancelled() -> MutexGuard<'static, Vec<u64>> {
+    static CANCELLED: OnceLock<Mutex<Vec<u64>>> = OnceLock::new();
+    CANCELLED
+        .get_or_init(Default::default)
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+}
+
+/// Whether the message was cancelled while its copies were being made,
+/// forgetting it either way.
+pub fn was_cancelled(id: u64) -> bool {
+    let mut cancelled = cancelled();
+    let before = cancelled.len();
+    cancelled.retain(|known| *known != id);
+    cancelled.len() != before
+}
+
+/// Lists this archive's queue in the composer, when the backend starts, and
+/// clears out copies kept for messages long sent.
+pub fn load(archive: &Archive, state: &Path) {
+    let queue = stored(archive);
+    sweep(state, &queue, SystemTime::now());
+    for item in queue {
+        show(item);
+    }
+}
+
+/// Clears out copies kept for messages long sent.
+pub fn tidy(archive: &Archive, state: &Path) {
+    sweep(state, &stored(archive), SystemTime::now());
+}
+
+/// Lists a message in the composer at once, before the backend saves it,
+/// or updates it once the backend has its copies.
+pub fn show(item: Scheduled) {
+    let mut shown = shown();
+    match shown.iter_mut().find(|known| known.id == item.id) {
+        Some(known) => *known = item,
+        None => shown.push(item),
+    }
+}
+
+/// Takes a message out of the composer's list at once.
+pub fn hide(id: u64) {
+    shown().retain(|item| item.id != id);
+}
+
+/// Saves a message to send later, and lists it once it is saved.
+pub fn add(archive: &Archive, item: Scheduled) -> Result<(), String> {
+    let mut queue = stored(archive);
+    if !queue.iter().any(|known| known.id == item.id) {
+        queue.push(item.clone());
+        store(archive, &queue)?;
+    }
+    show(item);
+    Ok(())
+}
+
+/// Drops a message that was to be sent later, with its copies. One no longer
+/// queued is either still being copied, and is dropped once it is, or already
+/// on its way, and keeps its files for the send.
+pub fn cancel(archive: &Archive, state: &Path, id: u64) -> Result<(), String> {
+    let mut queue = stored(archive);
+    let before = queue.len();
+    queue.retain(|item| item.id != id);
+    if queue.len() == before {
+        cancelled().push(id);
+    } else {
+        store(archive, &queue)?;
+        discard(state, id);
+    }
+    hide(id);
+    Ok(())
+}
+
+/// Takes the messages due by `now` out of the queue, oldest first. Nothing
+/// is due while the queue cannot be saved without them, so none goes twice.
+pub fn take_due(archive: &Archive, now: i64) -> Vec<Scheduled> {
+    let queue = stored(archive);
+    if !queue.iter().any(|item| item.at <= now) {
+        return Vec::new();
+    }
+    let (mut due, rest): (Vec<_>, Vec<_>) = queue.into_iter().partition(|item| item.at <= now);
+    if let Err(error) = store(archive, &rest) {
+        log::warn!("{error}; the due scheduled messages wait");
+        return Vec::new();
+    }
+    for item in &due {
+        hide(item.id);
+    }
+    due.sort_by_key(|item| item.at);
+    due
+}
+
+/// The messages waiting to go to `chat`, soonest first.
+pub fn for_chat(chat: &str) -> Vec<Scheduled> {
+    let mut items: Vec<_> = shown()
+        .iter()
+        .filter(|item| item.chat == chat)
+        .cloned()
+        .collect();
+    items.sort_by_key(|item| item.at);
+    items
+}
+
+/// Quick choices for when to send: a label and a Unix time.
+pub fn presets(now: i64) -> Vec<(String, i64)> {
+    let mut presets = vec![
+        ("In 1 hour".to_owned(), now + 60 * 60),
+        ("In 3 hours".to_owned(), now + 3 * 60 * 60),
+    ];
+    let Ok(timestamp) = jiff::Timestamp::from_second(now) else {
+        return presets;
+    };
+    let zone = jiff::tz::TimeZone::system();
+    let local = timestamp.to_zoned(zone.clone());
+    if let Ok(tonight) = local.date().at(21, 0, 0, 0).to_zoned(zone.clone()) {
+        let at = tonight.timestamp().as_second();
+        if at > now + 5 * 60 {
+            presets.push((format!("Tonight at {}", crate::util::clock(at)), at));
+        }
+    }
+    if let Ok(tomorrow) = local.date().tomorrow()
+        && let Ok(morning) = tomorrow.at(9, 0, 0, 0).to_zoned(zone)
+    {
+        let at = morning.timestamp().as_second();
+        presets.push((format!("Tomorrow at {}", crate::util::clock(at)), at));
+    }
+    presets
+}
+
+/// The hour and minute of "21:30" or "9:05".
+fn clock_of(text: &str) -> Option<(i8, i8)> {
+    let (hour, minute) = text.trim().split_once(':')?;
+    let hour: i8 = hour.trim().parse().ok().filter(|hour| (0..24).contains(hour))?;
+    let minute: i8 = minute
+        .trim()
+        .parse()
+        .ok()
+        .filter(|minute| (0..60).contains(minute))?;
+    Some((hour, minute))
+}
+
+/// The date `day` days after the one `now` falls on.
+fn date_after(now: i64, day: i64) -> Option<jiff::civil::Date> {
+    let mut date = jiff::Timestamp::from_second(now)
+        .ok()?
+        .to_zoned(jiff::tz::TimeZone::system())
+        .date();
+    for _ in 0..day {
+        date = date.tomorrow().ok()?;
+    }
+    Some(date)
+}
+
+/// When the clock reads `text` on the day `day` days from today. Today means
+/// the next time it does: today, or tomorrow once that has passed.
+pub fn at_on(now: i64, day: i64, text: &str) -> Option<i64> {
+    if day <= 0 {
+        return next_at(now, text);
+    }
+    let (hour, minute) = clock_of(text)?;
+    let date = date_after(now, day.min(LAST_DAY))?;
+    let at = date
+        .at(hour, minute, 0, 0)
+        .to_zoned(jiff::tz::TimeZone::system())
+        .ok()?;
+    Some(at.timestamp().as_second())
+}
+
+/// "Today", "Tomorrow", or "Thu 13 Nov" for the day `day` days from today.
+pub fn day_label(now: i64, day: i64) -> String {
+    match day {
+        ..=0 => "Today".to_owned(),
+        1 => "Tomorrow".to_owned(),
+        _ => date_after(now, day)
+            .map(|date| date.strftime("%a %d %b").to_string())
+            .unwrap_or_default(),
+    }
+}
+
+/// The next time the clock reads `text` ("21:30" or "9:05"): today, or
+/// tomorrow once that has passed.
+pub fn next_at(now: i64, text: &str) -> Option<i64> {
+    let (hour, minute) = clock_of(text)?;
+    let zone = jiff::tz::TimeZone::system();
+    let local = jiff::Timestamp::from_second(now).ok()?.to_zoned(zone.clone());
+    let today = local
+        .date()
+        .at(hour, minute, 0, 0)
+        .to_zoned(zone.clone())
+        .ok()?
+        .timestamp()
+        .as_second();
+    if today > now {
+        return Some(today);
+    }
+    let tomorrow = local.date().tomorrow().ok()?.at(hour, minute, 0, 0);
+    Some(tomorrow.to_zoned(zone).ok()?.timestamp().as_second())
+}
+
+/// "21:00", "Tomorrow at 09:00", or "Mon 03 Nov at 09:00".
+pub fn when_label(at: i64) -> String {
+    let time = crate::util::clock(at);
+    let Ok(timestamp) = jiff::Timestamp::from_second(at) else {
+        return time;
+    };
+    let date = timestamp.to_zoned(jiff::tz::TimeZone::system()).date();
+    let today = crate::util::today();
+    if date == today {
+        time
+    } else if today.tomorrow().ok() == Some(date) {
+        format!("Tomorrow at {time}")
+    } else {
+        format!("{} at {time}", date.strftime("%a %d %b"))
+    }
+}

+    /// Patched build: queues composed text to send at `at`, in Unix seconds,
+    /// with the open chat's staged attachments, the text as their caption.
+    pub(crate) fn schedule_text(&mut self, chat: ChatId, text: String, at: i64) {
+        let text = text.trim().to_owned();
+        let attaching = self.open_chat.as_deref() == Some(chat.as_str()) && !self.pending.is_empty();
+        if text.is_empty() && !attaching {
+            return;
+        }
+        let (text, mentions) = self.encode_composer_mentions(&chat, text);
+        self.emoji_start = None;
+        self.mention_start = None;
+        self.stop_composing(&chat);
+        self.drafts.remove(&chat);
+        self.draft_mentions.remove(&chat);
+        self.store_draft(&chat, "");
+        let mut attachments = Vec::new();
+        if attaching {
+            for staged in std::mem::take(&mut self.pending) {
+                attachments.push(match staged.item {
+                    Pending::File(path) => crate::scheduled::Attachment::File {
+                        path,
+                        document: false,
+                    },
+                    Pending::Document(path) => crate::scheduled::Attachment::File {
+                        path,
+                        document: true,
+                    },
+                    Pending::Picture {
+                        width,
+                        height,
+                        rgba,
+                        ..
+                    } => crate::scheduled::Attachment::Picture {
+                        width: width as u32,
+                        height: height as u32,
+                        rgba: std::sync::Arc::try_unwrap(rgba).unwrap_or_else(|arc| (*arc).clone()),
+                    },
+                });
+            }
+            self.pending_view_once = false;
+            self.forget_unstaged_pictures();
+        }
+        let mut item = crate::scheduled::Scheduled::new(chat, text, mentions, at);
+        item.files = attachments
+            .iter()
+            .map(crate::scheduled::Attachment::listed)
+            .collect();
+        crate::scheduled::show(item.clone());
+        self.backend.send(Command::ScheduleText(item, attachments));
+    }
+
+    /// Patched build: drops a queued text.
+    pub(crate) fn cancel_scheduled(&mut self, id: u64) {
+        crate::scheduled::hide(id);
+        self.backend.send(Command::CancelScheduled(id));
+    }

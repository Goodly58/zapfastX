+/// Patched build: the messages waiting to be sent to this chat, soonest
+/// first, each with a way to cancel it.
+fn scheduled_strip(app: &mut App, ui: &mut egui::Ui, chat: &str) {
+    let items = crate::scheduled::for_chat(&app.account().id, chat);
+    if items.is_empty() {
+        return;
+    }
+    let palette = app.palette;
+    widgets::raised(ui, &palette, strip_frame(&palette), |ui| {
+        ui.set_width(ui.available_width());
+        for item in &items {
+            ui.horizontal(|ui| {
+                theme::icon(ui, Icon::Clock, 16.0, palette.accent);
+                theme::text(
+                    ui,
+                    crate::scheduled::when_label(item.at),
+                    theme::semibold(12.5),
+                    palette.accent,
+                );
+                let preview = item.preview();
+                let width = (ui.available_width() - 30.0).max(0.0);
+                ui.allocate_ui_with_layout(
+                    vec2(width, 18.0),
+                    Layout::left_to_right(Align::Center),
+                    |ui| {
+                        theme::text(ui, preview, theme::regular(12.5), palette.secondary);
+                    },
+                );
+                if theme::icon_button(
+                    ui,
+                    Icon::X,
+                    16.0,
+                    palette.secondary,
+                    palette.text,
+                    "Cancel scheduled message",
+                )
+                .clicked()
+                {
+                    app.cancel_scheduled(item.id);
+                }
+            });
+        }
+    });
+    strip_gap(ui);
+}

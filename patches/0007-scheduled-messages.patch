+        let state = tempfile::tempdir().unwrap();
+        std::fs::create_dir_all(files_dir(state.path(), 77)).unwrap();
+        // Not queued yet: the copy is still being made.
+        cancel(&archive, state.path(), 77).unwrap();
+        assert!(files_dir(state.path(), 77).exists(), "the copy in progress is left to finish");
+        assert!(was_cancelled(77));
+        assert!(!was_cancelled(77), "the cancel is consumed once");

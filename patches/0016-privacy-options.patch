+/// Notes who deleted `old` for everyone when it was not its sender, as a
+/// group admin can, so the cover can name them.
+pub fn remember_revoker(archive: &Archive, chat: &str, old: &Message, who: &str) {
+    if old.sender == who {
+        return;
+    }
+    let line = line(chat, &old.id);
+    revokers()
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .insert(line.clone(), who.to_owned());
+    let entry = format!("{line}\t{who}");
+    let stored = archive
+        .meta(REVOKERS_KEY)
+        .ok()
+        .flatten()
+        .unwrap_or_default();
+    if stored.lines().any(|kept| kept == entry) {
+        return;
+    }
+    let value = if stored.is_empty() {
+        entry
+    } else {
+        format!("{stored}\n{entry}")
+    };
+    if let Err(error) = archive.set_meta(REVOKERS_KEY, &value) {
+        log::warn!("could not save who deleted a message: {error}");
+    }
+}
+
+/// Who deleted a kept message: its sender, unless someone else did.
+pub fn revoker(message: &Message) -> String {
+    revokers()
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+        .get(&line(&message.chat, &message.id))
+        .cloned()
+        .unwrap_or_else(|| message.sender.clone())
+}

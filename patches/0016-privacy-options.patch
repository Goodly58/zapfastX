diff --git a/src/group_reads.rs b/src/group_reads.rs
new file mode 100644
index 0000000..2ed3d65
--- /dev/null
+++ b/src/group_reads.rs
@@ -0,0 +1,18 @@
+//! ZapFastX: whether reading a group here tells the phone while read
+//! receipts are off. The phone applies the read and then sends the group its
+//! read receipts itself, as WhatsApp's own apps always do in groups, so by
+//! default it is not told and keeps the group unread.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+
+static SYNC: AtomicBool = AtomicBool::new(false);
+
+/// Follows Settings → Privacy → Sync group reads to phone.
+pub fn set(sync: bool) {
+    SYNC.store(sync, Ordering::Relaxed);
+}
+
+/// Whether a group read here goes to the phone with receipts off.
+pub fn sync() -> bool {
+    SYNC.load(Ordering::Relaxed)
+}

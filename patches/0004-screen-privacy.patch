+/// Which screen-privacy switch covers a message.
+fn privacy_what(content: &Content) -> ScreenPrivacyWhat {
+    match content {
+        Content::Text { .. } | Content::Interactive { .. } | Content::Poll { .. } => {
+            ScreenPrivacyWhat::Message
+        }
+        _ => ScreenPrivacyWhat::Media,
+    }

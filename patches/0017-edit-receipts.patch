index 0000000..6e89611
--- /dev/null
+++ b/src/edit_receipts.rs
@@ -0,0 +1,155 @@
+//! Patched build: receipts for an edit count toward the message it edits.
+//!
+//! An edit travels as a message of its own with a fresh id, and people who
+//! open the chat after it send their read receipt for that id, so a group's
+//! Message info named only those who read before the edit. The archive's meta
+//! table remembers which ids are edits of which of our messages, one
+//! `chat\tedit\toriginal` per line, newest last. The map is process-wide like
+//! the other patched sets; edit ids are random, so accounts never collide.
+
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock, PoisonError};
+
+use crate::archive::Archive;
+use crate::model::Delivery;
+
+const META_KEY: &str = "fork_edit_ids";
+/// Edits remembered. Older ones are long past their last receipt.
+const KEEP: usize = 2000;
+
+type Edits = HashMap<(String, String), String>;
+
+fn edits() -> std::sync::MutexGuard<'static, Edits> {
+    static EDITS: OnceLock<Mutex<Edits>> = OnceLock::new();
+    EDITS
+        .get_or_init(Default::default)
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+}
+
+fn parse(line: &str) -> Option<(&str, &str, &str)> {
+    let (chat, rest) = line.split_once('\t')?;
+    let (edit, original) = rest.split_once('\t')?;
+    Some((chat, edit, original))
+}
+
+/// Restores the edits this archive remembered, when the backend starts.
+pub fn load(archive: &Archive) {
+    let Ok(Some(stored)) = archive.meta(META_KEY) else {
+        return;
+    };
+    let mut edits = edits();
+    for (chat, edit, original) in stored.lines().filter_map(parse) {
+        edits.insert((chat.to_owned(), edit.to_owned()), original.to_owned());
+    }
+}
+
+/// Notes that `edit` is the id of an edit to our message `original`.
+pub fn remember(archive: &Archive, chat: &str, edit: &str, original: &str) {
+    if edit.is_empty() || edit == original {
+        return;
+    }
+    let key = (chat.to_owned(), edit.to_owned());
+    if edits().insert(key, original.to_owned()).as_deref() == Some(original) {
+        return;
+    }
+    let entry = format!("{chat}\t{edit}\t{original}");
+    let stored = archive.meta(META_KEY).ok().flatten().unwrap_or_default();
+    let mut lines: Vec<&str> = stored
+        .lines()
+        .filter(|line| parse(line).is_some())
+        .collect();
+    lines.push(&entry);
+    let value = lines[lines.len().saturating_sub(KEEP)..].join("\n");
+    if let Err(error) = archive.set_meta(META_KEY, &value) {
+        log::warn!("could not remember an edit: {error}");
+    }
+}
+
+/// A receipt's message ids with each of our edits replaced by the message it
+/// edits, without repeats.
+pub fn resolve(chat: &str, ids: &[impl AsRef<str>]) -> Vec<String> {
+    let edits = edits();
+    let mut resolved: Vec<String> = Vec::with_capacity(ids.len());
+    for id in ids {
+        let id = id.as_ref();
+        let id = edits
+            .get(&(chat.to_owned(), id.to_owned()))
+            .map_or(id, String::as_str)
+            .to_owned();
+        if !resolved.contains(&id) {
+            resolved.push(id);
+        }
+    }
+    resolved
+}
+
+/// Files receipts that arrived under `edit` before it was known to be one
+/// (the phone's edit can be decrypted after its first receipts) under
+/// `original` too. Returns whether there were any.
+pub fn adopt(archive: &Archive, chat: &str, edit: &str, original: &str) -> bool {
+    let Ok(parked) = archive.receipts(chat, edit) else {
+        return false;
+    };
+    let mut adopted = false;
+    for recipient in parked {
+        for (status, at) in [
+            (Delivery::Delivered, recipient.delivered_at),
+            (Delivery::Read, recipient.read_at),
+            (Delivery::Played, recipient.played_at),
+        ] {
+            if let Some(at) = at {
+                adopted |= archive
+                    .file_receipt(chat, original, &recipient.id, status, at)
+                    .unwrap_or(false);
+            }
+        }
+    }
+    adopted
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn an_edits_receipts_count_for_the_message_it_edits() {
+        let archive = Archive::in_memory().unwrap();
+        let chat = "120363000000000001@g.us";
+        remember(&archive, chat, "EDIT-A", "ORIGINAL-A");
+        let ids = [
+            "EDIT-A".to_owned(),
+            "ORIGINAL-A".to_owned(),
+            "OTHER".to_owned(),
+        ];
+        assert_eq!(resolve(chat, &ids), ["ORIGINAL-A", "OTHER"]);
+        // Another chat's message of the same id is left alone.
+        assert_eq!(resolve("120363000000000002@g.us", &ids[..1]), ["EDIT-A"]);
+    }
+
+    #[test]
+    fn remembered_edits_survive_a_restart() {
+        let archive = Archive::in_memory().unwrap();
+        let chat = "120363000000000003@g.us";
+        remember(&archive, chat, "EDIT-B", "ORIGINAL-B");
+        edits().remove(&(chat.to_owned(), "EDIT-B".to_owned()));
+        load(&archive);
+        assert_eq!(resolve(chat, &["EDIT-B".to_owned()]), ["ORIGINAL-B"]);
+    }
+
+    #[test]
+    fn receipts_filed_under_an_edit_move_to_the_message() {
+        let archive = Archive::in_memory().unwrap();
+        let chat = "120363000000000004@g.us";
+        let reader = "15550000001@s.whatsapp.net";
+        archive
+            .file_receipt(chat, "EDIT-C", reader, Delivery::Read, 1_700_000_100)
+            .unwrap();
+        assert!(adopt(&archive, chat, "EDIT-C", "ORIGINAL-C"));
+        let receipts = archive.receipts(chat, "ORIGINAL-C").unwrap();
+        assert_eq!(receipts.len(), 1);
+        assert_eq!(receipts[0].id, reader);
+        assert_eq!(receipts[0].read_at, Some(1_700_000_100));
+        assert!(!adopt(&archive, chat, "NOTHING", "ORIGINAL-C"));
+    }
+}
